// Aikyaa: Operating system for a parent organization managing multiple independent businesses.
// SQLite for dev; Postgres-compatible — switch datasource provider + DATABASE_URL for production.
// Enum-like fields are strings with app-level constants (src/lib/constants.ts).
//
// Core invariants enforced here and in the service layer:
//   - Task.dueDate NOT NULL, exactly one assignee
//   - ActivityLog is append-only (no update/delete code path exists;
//     on Postgres additionally REVOKE UPDATE/DELETE on the table)
//   - deletes are archives (archivedAt), never row deletion

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// The foundation: an independent business unit under Aikyaa.
model Business {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  tagline        String?
  description    String?
  industry       String?  // free text, not enum — for flexible grouping/filtering
  status         String   @default("active") // "planned" | "active" | "paused" | "sunset"
  logoUrl        String?
  coverImageUrl  String?
  brandColors    String?  // JSON [{name, hex}] — lightweight, for chips/theming
  launchDate     DateTime?
  website        String?
  contactEmail   String?
  contactPhone   String?
  socialLinks    String?  // JSON {twitter, instagram, linkedin, ...}
  notes          String?
  sortOrder      Int      @default(0)
  archivedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workstreams    Workstream[]
  projects       Project[]        // primary business
  projectLinks   ProjectBusiness[]
  taskLinks      TaskBusiness[]
  assets         Asset[]          // primary business
  assetLinks     AssetBusiness[]
  accessGrants   AccessGrant[]
  tags           BusinessTag[]
  meetingLinks   MeetingBusiness[]
  announcements  Announcement[]

  @@index([status])
  @@index([createdAt])
}

// Many-to-many: a task can belong to multiple businesses.
model TaskBusiness {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@unique([taskId, businessId])
}

// Many-to-many: a project can be linked to multiple businesses (e.g., shared initiatives).
model ProjectBusiness {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@unique([projectId, businessId])
}

// Many-to-many: an asset can belong to multiple businesses.
model AssetBusiness {
  id         String   @id @default(cuid())
  assetId    String
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@unique([assetId, businessId])
}

// Seeded, admin-extensible reference table for asset categories.
model AssetCategory {
  id         String   @id @default(cuid())
  key        String   @unique
  name       String
  icon       String?
  parentId   String?
  parent     AssetCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children   AssetCategory[] @relation("CategoryTree")
  sortOrder  Int      @default(0)
  isSystem   Boolean  @default(false)
  archivedAt DateTime?

  assets     Asset[]
}

// Structured brand & resource hub per business.
model Asset {
  id             String    @id @default(cuid())
  businessId     String    // primary business
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessLinks  AssetBusiness[]           // extra businesses
  categoryId     String
  category       AssetCategory @relation(fields: [categoryId], references: [id])
  projectId      String?   // optional link to a project
  project        Project?  @relation(fields: [projectId], references: [id])
  name           String
  description    String?
  kind           String    // "link" | "file"
  url            String?   // for kind = link
  filePath       String?   // stored filename under uploads/, for kind = file
  fileName       String?
  fileSize       Int?
  mimeType       String?
  version        Int       @default(1)
  parentAssetId  String?   // chaining: generic versioning/variant relation
  parentAsset    Asset?    @relation("AssetChain", fields: [parentAssetId], references: [id])
  childAssets    Asset[]   @relation("AssetChain")
  isPinned       Boolean   @default(false) // org-wide featured flag
  customFields   String?   // JSON [{key, value}]
  addedById      String
  addedBy        User      @relation(fields: [addedById], references: [id])
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tags           AssetTag[]
  taskLinks      TaskAsset[]
  favoritedBy    Favorite[]
  accessGrants   AccessGrant[]

  @@index([businessId])
  @@index([categoryId])
  @@index([createdAt])
}

// Shared vocabulary: tags for assets, tasks, and businesses.
model Tag {
  id    String @id @default(cuid())
  name  String @unique
  color String?
  assets     AssetTag[]
  tasks      TaskTag[]
  businesses BusinessTag[]
}

model AssetTag {
  id      String @id @default(cuid())
  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  tagId   String
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@unique([assetId, tagId])
}

model TaskTag {
  id     String @id @default(cuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@unique([taskId, tagId])
}

model BusinessTag {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tagId      String
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@unique([businessId, tagId])
}

// Shared-team structure: departments and skills.
model Department {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  sortOrder  Int      @default(0)
  archivedAt DateTime?
  users      User[]
}

model Skill {
  id    String @id @default(cuid())
  name  String @unique
  users UserSkill[]
}

model UserSkill {
  id      String  @id @default(cuid())
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId String
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  level   String? // "beginner" | "intermediate" | "expert"
  @@unique([userId, skillId])
}

// Workstream: business-scoped kanban service line (was Vertical, company-scoped).
model Workstream {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  slug       String
  isSystem   Boolean  @default(false) // Change Requests-style protection
  sortOrder  Int      @default(0)
  archivedAt DateTime?
  stages     PipelineStage[]
  projects   ProjectWorkstream[]
  tasks      Task[]
  @@unique([businessId, slug])
}

// Kanban column within a workstream.
model PipelineStage {
  id          String    @id @default(cuid())
  workstreamId String
  workstream  Workstream @relation(fields: [workstreamId], references: [id], onDelete: Cascade)
  name        String
  sortOrder   Int
  isTerminal  Boolean   @default(false)
  archivedAt  DateTime?
  tasks       Task[]
}

// Attaches a Workstream to a Project -> its own kanban board.
model ProjectWorkstream {
  id          String     @id @default(cuid())
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workstreamId String
  workstream  Workstream @relation(fields: [workstreamId], references: [id], onDelete: Cascade)
  @@unique([projectId, workstreamId])
}

model ProjectTemplate {
  id          String    @id @default(cuid())
  key         String    @unique
  name        String
  description String?
  config      String    // JSON: { workstreams: [slug], milestones: [{title, offsetDays}], tasks: [{title, workstream, offsetDays, estimateHours, priority}] }
  archivedAt  DateTime?
  projects    Project[]
}

model Project {
  id            String           @id @default(cuid())
  businessId    String           // primary business (required)
  business      Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessLinks ProjectBusiness[]           // extra businesses for cross-business initiatives
  name          String
  templateId    String?
  template      ProjectTemplate? @relation(fields: [templateId], references: [id])
  ownerId       String           // the PM
  owner         User             @relation(fields: [ownerId], references: [id])
  status        String           @default("active") // "active" | "completed" | "archived"
  startDate     DateTime         @default(now())
  endDate       DateTime?
  notes         String?
  archivedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  workstreams   ProjectWorkstream[]
  milestones    Milestone[]
  tasks         Task[]
  assets        Asset[]
  members       ProjectMember[]

  @@index([businessId])
  @@index([status])
}

model ProjectMember {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([projectId, userId])
}

model Milestone {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title      String
  dueDate    DateTime // mandatory, like everything else
  status     String   @default("pending") // "pending" | "completed"
  completedAt DateTime?
  archivedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([projectId, dueDate])
}

// Core task model.
model Task {
  id                String   @id @default(cuid())
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workstreamId      String
  workstream        Workstream @relation(fields: [workstreamId], references: [id], onDelete: Cascade)
  stageId           String
  stage             PipelineStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  businessLinks     TaskBusiness[]  // one-or-more businesses
  title             String
  description       String?
  assigneeId        String  // exactly one assignee — NOT NULL by design
  assignee          User    @relation("assignedTasks", fields: [assigneeId], references: [id])
  creatorId         String
  creator           User    @relation("createdTasks", fields: [creatorId], references: [id])
  dueDate           DateTime // NOT NULL — the system's core invariant
  originalDueDate   DateTime // first deadline ever set; displayed forever
  priority          String  @default("medium") // "low" | "medium" | "high" | "urgent"
  estimateHours     Float   @default(0)
  // Tickets are tasks in the Change Requests workstream:
  isTicket          Boolean @default(false)
  ticketType        String? // "change" | "bug" | "revision"
  raisedById        String?
  raisedBy          User?   @relation("raisedTickets", fields: [raisedById], references: [id])
  // Variations link to their master:
  masterTaskId      String?
  masterTask        Task?   @relation("variations", fields: [masterTaskId], references: [id])
  variations        Task[]  @relation("variations")
  // Escalation state (managed by the engine, idempotent per rung):
  escalationLevel   Int     @default(0) // 0 none, 1 reminded, 2 overdue, 3 owner, 4 review+locked
  overdueSince      DateTime?
  deadlineLocked    Boolean @default(false)
  completedAt       DateTime?
  archivedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  subtasks          Subtask[]
  assetLinks        TaskAsset[]
  watchers          TaskWatcher[]
  extensionRequests ExtensionRequest[]
  tags              TaskTag[]
  dependsOn         TaskDependency[] @relation("dependent")
  blocks            TaskDependency[] @relation("dependency")

  @@index([assigneeId, completedAt])
  @@index([projectId, workstreamId])
  @@index([dueDate])
}

// Task dependencies: simple "blocks/blocked by" relations.
model TaskDependency {
  id          String @id @default(cuid())
  taskId      String
  task        Task   @relation("dependent", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnId String
  dependsOn   Task   @relation("dependency", fields: [dependsOnId], references: [id], onDelete: Cascade)
  @@unique([taskId, dependsOnId])
}

model Subtask {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title     String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model TaskAsset {
  id        String @id @default(cuid())
  taskId    String
  task      Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assetId   String
  asset     Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  direction String // "input" | "output"
  @@unique([taskId, assetId, direction])
}

model TaskWatcher {
  id     String @id @default(cuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([taskId, userId])
}

model ExtensionRequest {
  id            String    @id @default(cuid())
  taskId        String
  task          Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   User      @relation("extensionRequests", fields: [requestedById], references: [id])
  requestedDate DateTime
  reason        String
  status        String    @default("pending") // "pending" | "approved" | "rejected"
  decidedById   String?
  decidedBy     User?     @relation("extensionDecisions", fields: [decidedById], references: [id])
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime  @default(now())
}

// Per-user asset bookmarks.
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([userId, assetId])
}

// Access vault: who has access to which business resource.
model AccessGrant {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  assetId    String?   // optional: link to a specific asset
  asset      Asset?    @relation(fields: [assetId], references: [id])
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   String    // e.g. "Meta Ads account", "GitHub repo"
  notes      String?
  grantedAt  DateTime  @default(now())
  revokedAt  DateTime?
}

// Shared User model across all businesses.
model User {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  passwordHash       String
  title              String?
  phone              String?
  capacityHours      Float    @default(40) // weekly capacity
  avatarColor        String   @default("#3d64f1")
  departmentId       String?
  department         Department? @relation(fields: [departmentId], references: [id])
  responsibilities   String?
  availabilityStatus String   @default("available") // "available" | "reduced" | "on_leave"
  awayUntil          DateTime?
  archivedAt         DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  roleAssignments    RoleAssignment[]
  sessions           Session[]
  assignedTasks      Task[]   @relation("assignedTasks")
  createdTasks       Task[]   @relation("createdTasks")
  raisedTickets      Task[]   @relation("raisedTickets")
  ownedProjects      Project[]
  skills             UserSkill[]
  registeredAssets   Asset[]
  accessGrants       AccessGrant[]
  watching           TaskWatcher[]
  extensionRequests  ExtensionRequest[] @relation("extensionRequests")
  extensionDecisions ExtensionRequest[] @relation("extensionDecisions")
  comments           Comment[]
  notifications      Notification[]
  projectMemberships ProjectMember[]
  favorites          Favorite[]
  announcements      Announcement[]
  meetings           Meeting[]
}

// Role per scope: a person can be Member on one business and Lead on another.
model RoleAssignment {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String // "owner" | "lead" | "member"
  scopeType String // "organization" | "business" | "project"
  scopeId   String // "org" literal for organization scope; business/project UUID otherwise
  @@unique([userId, role, scopeType, scopeId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// "When [deadline event] then [action]" — configurable per scope.
model EscalationRule {
  id          String  @id @default(cuid())
  scopeType   String // "organization" | "business" | "project"
  scopeId     String
  offsetHours Int    // relative to due date: -24 = 24h before, 0 = on cross, 24, 48...
  action      String // "remind_assignee" | "mark_overdue_notify_pm" | "escalate_owner" | "schedule_review_lock"
  level       Int    // rung on the ladder, drives idempotency
  enabled     Boolean @default(true)
}

// Append-only. No update/delete code path exists anywhere in the app.
model ActivityLog {
  id         String   @id @default(cuid())
  actorId    String?  // null => SYSTEM
  actorName  String   // denormalized so the log stays readable forever
  entityType String   // "task" | "project" | "meeting" | "milestone" | "business" | "asset" | "extension_request" | ...
  entityId   String
  action     String   // "created" | "stage_moved" | "deadline_changed" | "assigned" | "commented" | "escalation.*" | ...
  fromValue  String?
  toValue    String?
  meta       String?  // JSON
  projectId  String?  // denormalized filters for sheets/analytics
  businessId String?
  taskId     String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([projectId])
  @@index([businessId])
  @@index([taskId])
  @@index([createdAt])
}

model Comment {
  id         String   @id @default(cuid())
  entityType String   // "task" | "project" | "meeting"
  entityId   String
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body       String
  createdAt  DateTime @default(now())
  @@index([entityType, entityId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String    // "reminder" | "overdue" | "escalation" | "assignment" | "extension" | "digest" | "announcement" | "meeting"
  title     String
  body      String?
  link      String?
  channel   String    @default("in_app") // "in_app" | "email" | "whatsapp" (email/whatsapp are logged stubs in v1)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  @@index([userId, readAt])
}

// Announcements: pinned updates for the team.
model Announcement {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title      String
  body       String
  authorId   String
  author     User      @relation(fields: [authorId], references: [id])
  pinned     Boolean   @default(false)
  publishedAt DateTime @default(now())
  expiresAt  DateTime?
  archivedAt DateTime?
  @@index([businessId, publishedAt])
}

// Meetings: schedulable events linked to one or more businesses.
model Meeting {
  id          String   @id @default(cuid())
  title       String
  notes       String?
  startsAt    DateTime
  endsAt      DateTime?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  archivedAt  DateTime?
  createdAt   DateTime @default(now())

  businessLinks MeetingBusiness[]
  @@index([startsAt])
}

model MeetingBusiness {
  id         String   @id @default(cuid())
  meetingId  String
  meeting    Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@unique([meetingId, businessId])
}
