// Data model.
// SQLite for dev; the schema is Postgres-compatible — switch the datasource
// provider + DATABASE_URL for production. Enum-like fields are strings with
// app-level constants (src/lib/constants.ts) so the schema works on both.
//
// Non-negotiable constraints enforced here and in the service layer:
//   - Task.dueDate NOT NULL, exactly one assignee
//   - ActivityLog is append-only (no update/delete code path exists;
//     on Postgres additionally REVOKE UPDATE/DELETE on the table)
//   - deletes are archives (archivedAt), never row deletion

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id        String     @id @default(cuid())
  name      String
  createdAt DateTime   @default(now())
  divisions Division[]
  verticals Vertical[]
}

model Division {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id])
  name       String
  slug       String    @unique
  sortOrder  Int       @default(0)
  archivedAt DateTime?
  clients    Client[]
}

model Client {
  id           String        @id @default(cuid())
  divisionId   String
  division     Division      @relation(fields: [divisionId], references: [id])
  name         String
  slug         String        @unique
  kind         String // "external" | "internal"
  contactName  String?
  contactEmail String?
  notes        String?
  archivedAt   DateTime?
  createdAt    DateTime      @default(now())
  brandKit     BrandKit?
  assets       Asset[]
  deals        Deal[]
  projects     Project[]
  invoices     Invoice[]
  accessGrants AccessGrant[]
}

model BrandKit {
  id             String  @id @default(cuid())
  clientId       String  @unique
  client         Client  @relation(fields: [clientId], references: [id])
  logoUrl        String?
  colors         String? // JSON array of {name, hex}
  fonts          String?
  toneOfVoiceUrl String?
  dosAndDonts    String?
  notes          String?
}

model Asset {
  id             String      @id @default(cuid())
  clientId       String
  client         Client      @relation(fields: [clientId], references: [id])
  projectId      String?
  project        Project?    @relation(fields: [projectId], references: [id])
  verticalId     String?
  vertical       Vertical?   @relation(fields: [verticalId], references: [id])
  name           String
  url            String
  type           String // "footage" | "master" | "final" | "doc" | "image" | "design" | "other"
  version        Int         @default(1)
  tags           String? // comma-separated
  parentAssetId  String? // asset chaining: footage -> master -> variation
  parentAsset    Asset?      @relation("AssetChain", fields: [parentAssetId], references: [id])
  childAssets    Asset[]     @relation("AssetChain")
  isDeliverable  Boolean     @default(false)
  registeredById String
  registeredBy   User        @relation(fields: [registeredById], references: [id])
  archivedAt     DateTime?
  createdAt      DateTime    @default(now())
  taskLinks      TaskAsset[]
}

// Who has access to which client property (ad account, page, domain, repo).
// Stores who-has-what, never passwords.
model AccessGrant {
  id        String    @id @default(cuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id])
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  property  String // e.g. "Meta Ads account", "GitHub repo"
  notes     String?
  grantedAt DateTime  @default(now())
  revokedAt DateTime?
}

model Deal {
  id                 String    @id @default(cuid())
  clientId           String? // null for prospects (service deals not yet won)
  client             Client?   @relation(fields: [clientId], references: [id])
  kind               String // "service" | "brand"
  name               String
  prospectName       String? // company name before a Client record exists
  contactName        String?
  contactEmail       String?
  stage              String // service: lead|qualified|proposal|negotiation|won|lost ; brand: outreach|in_talks|terms|signed|deliverables|completed|paid
  value           Int       @default(0)
  ownerId            String
  owner              User      @relation(fields: [ownerId], references: [id])
  notes              String?
  lastActivityAt     DateTime  @default(now())
  convertedProjectId String?
  archivedAt         DateTime?
  createdAt          DateTime  @default(now())
}

model ProjectTemplate {
  id          String    @id @default(cuid())
  key         String    @unique
  name        String
  description String?
  config      String // JSON: { verticals: [slug], milestones: [{title, offsetDays, billable}], tasks: [{title, vertical, offsetDays, estimateHours, priority}] }
  archivedAt  DateTime?
  projects    Project[]
}

model Project {
  id         String           @id @default(cuid())
  clientId   String
  client     Client           @relation(fields: [clientId], references: [id])
  name       String
  templateId String?
  template   ProjectTemplate? @relation(fields: [templateId], references: [id])
  value   Int              @default(0)
  ownerId    String // the PM
  owner      User             @relation(fields: [ownerId], references: [id])
  status     String           @default("active") // "active" | "completed" | "archived"
  startDate  DateTime         @default(now())
  endDate    DateTime?
  notes      String?
  archivedAt DateTime?
  createdAt  DateTime         @default(now())
  verticals  ProjectVertical[]
  milestones Milestone[]
  tasks      Task[]
  assets     Asset[]
  invoices   Invoice[]
  members    ProjectMember[]
}

// Attaches a Vertical (service line) to a Project -> its own kanban board.
model ProjectVertical {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  verticalId String
  vertical   Vertical @relation(fields: [verticalId], references: [id])

  @@unique([projectId, verticalId])
}

model ProjectMember {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])
  userId    String
  user      User    @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
}

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id])
  title       String
  dueDate     DateTime // mandatory, like everything else
  billable    Boolean   @default(false)
  amount   Int       @default(0)
  status      String    @default("pending") // "pending" | "completed"
  completedAt DateTime?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  invoices    Invoice[]
}

// Company-level vertical (service line) with its ordered pipeline.
model Vertical {
  id         String            @id @default(cuid())
  companyId  String
  company    Company           @relation(fields: [companyId], references: [id])
  name       String
  slug       String            @unique
  isSystem   Boolean           @default(false) // Change Requests vertical is protected
  sortOrder  Int               @default(0)
  archivedAt DateTime?
  stages     PipelineStage[]
  projects   ProjectVertical[]
  tasks      Task[]
  assets     Asset[]
}

model PipelineStage {
  id         String    @id @default(cuid())
  verticalId String
  vertical   Vertical  @relation(fields: [verticalId], references: [id])
  name       String
  sortOrder  Int
  isTerminal Boolean   @default(false) // reaching this stage completes the task
  archivedAt DateTime?
  tasks      Task[]
}

model Task {
  id              String    @id @default(cuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id])
  verticalId      String
  vertical        Vertical  @relation(fields: [verticalId], references: [id])
  stageId         String
  stage           PipelineStage @relation(fields: [stageId], references: [id])
  title           String
  description     String?
  assigneeId      String // exactly one assignee — NOT NULL by design
  assignee        User      @relation("assignedTasks", fields: [assigneeId], references: [id])
  creatorId       String
  creator         User      @relation("createdTasks", fields: [creatorId], references: [id])
  dueDate         DateTime // NOT NULL — the system's core invariant
  originalDueDate DateTime // first deadline ever set; displayed forever
  priority        String    @default("medium") // "low" | "medium" | "high" | "urgent"
  estimateHours   Float     @default(0)
  tags            String?
  // Tickets are tasks in the Change Requests vertical:
  isTicket        Boolean   @default(false)
  ticketType      String? // "change" | "bug" | "revision"
  raisedById      String?
  raisedBy        User?     @relation("raisedTickets", fields: [raisedById], references: [id])
  // Variations link to their master:
  masterTaskId    String?
  masterTask      Task?     @relation("variations", fields: [masterTaskId], references: [id])
  variations      Task[]    @relation("variations")
  // Escalation state (managed by the engine, idempotent per rung):
  escalationLevel Int       @default(0) // 0 none, 1 reminded, 2 overdue, 3 CEO, 4 review+locked
  overdueSince    DateTime?
  deadlineLocked  Boolean   @default(false)
  completedAt     DateTime?
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  subtasks        Subtask[]
  assetLinks      TaskAsset[]
  watchers        TaskWatcher[]
  extensionRequests ExtensionRequest[]

  @@index([assigneeId, completedAt])
  @@index([projectId, verticalId])
  @@index([dueDate])
}

model Subtask {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id])
  title     String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model TaskAsset {
  id        String @id @default(cuid())
  taskId    String
  task      Task   @relation(fields: [taskId], references: [id])
  assetId   String
  asset     Asset  @relation(fields: [assetId], references: [id])
  direction String // "input" | "output"

  @@unique([taskId, assetId, direction])
}

model TaskWatcher {
  id     String @id @default(cuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id])
  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([taskId, userId])
}

model ExtensionRequest {
  id            String    @id @default(cuid())
  taskId        String
  task          Task      @relation(fields: [taskId], references: [id])
  requestedById String
  requestedBy   User      @relation("extensionRequests", fields: [requestedById], references: [id])
  requestedDate DateTime
  reason        String
  status        String    @default("pending") // "pending" | "approved" | "rejected"
  decidedById   String?
  decidedBy     User?     @relation("extensionDecisions", fields: [decidedById], references: [id])
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime  @default(now())
}

model Invoice {
  id          String     @id @default(cuid())
  number      String     @unique
  clientId    String
  client      Client     @relation(fields: [clientId], references: [id])
  projectId   String?
  project     Project?   @relation(fields: [projectId], references: [id])
  milestoneId String?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id])
  status      String     @default("draft") // "draft" | "sent" | "partial" | "paid" | "overdue"
  fileName    String? // original name of the CA-issued invoice file
  filePath    String? // stored name under uploads/, served via /api/files/[name]
  lineItems   String // JSON [{description, amount}]
  subtotal Int
  taxPercent  Float      @default(18)
  total    Int
  issueDate   DateTime   @default(now())
  dueDate     DateTime
  notes       String?
  isInternal  Boolean    @default(false) // cost-tracking invoice for internal clients
  archivedAt  DateTime?
  createdAt   DateTime   @default(now())
  payments    Payment[]
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  amount Int
  paidAt    DateTime @default(now())
  method    String?
  reference String?
}

model User {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  passwordHash       String
  title              String?
  phone              String?
  capacityHours      Float    @default(40) // weekly capacity
  avatarColor        String   @default("#3d64f1")
  archivedAt         DateTime?
  createdAt          DateTime @default(now())
  roleAssignments    RoleAssignment[]
  sessions           Session[]
  assignedTasks      Task[]   @relation("assignedTasks")
  createdTasks       Task[]   @relation("createdTasks")
  raisedTickets      Task[]   @relation("raisedTickets")
  ownedProjects      Project[]
  ownedDeals         Deal[]
  registeredAssets   Asset[]
  accessGrants       AccessGrant[]
  watching           TaskWatcher[]
  extensionRequests  ExtensionRequest[] @relation("extensionRequests")
  extensionDecisions ExtensionRequest[] @relation("extensionDecisions")
  comments           Comment[]
  notifications      Notification[]
  projectMemberships ProjectMember[]
  resourceLinks      ResourceLink[]
}

// The Links hub: one place for every link the team lives in — Drive folders,
// Notion docs, brand dashboards, tools. Company-wide; optionally pinned to a
// client.
model ResourceLink {
  id         String    @id @default(cuid())
  title      String
  url        String
  category   String    @default("General") // e.g. "Drive", "Docs", "Tools", "Dashboards"
  notes      String?
  clientId   String?
  addedById  String
  addedBy    User      @relation(fields: [addedById], references: [id])
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
}

// Role per scope: a person can be Member on one division and Lead on another.
model RoleAssignment {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id])
  role      String // "ceo" | "lead" | "member" | "sales" | "finance"
  scopeType String // "company" | "division" | "client" | "project"
  scopeId   String

  @@unique([userId, role, scopeType, scopeId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// "When [deadline event] then [action]" — configurable per scope.
model EscalationRule {
  id          String  @id @default(cuid())
  scopeType   String // "company" | "division" | "client" | "project"
  scopeId     String
  offsetHours Int // relative to due date: -24 = 24h before, 0 = on cross, 24, 48...
  action      String // "remind_assignee" | "mark_overdue_notify_pm" | "escalate_ceo" | "schedule_review_lock"
  level       Int // rung on the ladder, drives idempotency
  enabled     Boolean @default(true)
}

// Append-only. No update/delete code path exists anywhere in the app.
model ActivityLog {
  id         String   @id @default(cuid())
  actorId    String? // null => SYSTEM
  actorName  String // denormalized so the log stays readable forever
  entityType String // "task" | "project" | "deal" | "invoice" | "milestone" | "client" | "asset" | "extension_request" | ...
  entityId   String
  action     String // "created" | "stage_moved" | "deadline_changed" | "assigned" | "commented" | "escalation.*" | ...
  fromValue  String?
  toValue    String?
  meta       String? // JSON
  projectId  String? // denormalized filters for sheets/analytics
  clientId   String?
  taskId     String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([projectId])
  @@index([taskId])
  @@index([createdAt])
}

model Comment {
  id         String   @id @default(cuid())
  entityType String // "task" | "deal" | "project"
  entityId   String
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  body       String
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  type      String // "reminder" | "overdue" | "escalation" | "assignment" | "extension" | "digest" | "invoice" | "deal"
  title     String
  body      String?
  link      String?
  channel   String    @default("in_app") // "in_app" | "email" | "whatsapp" (email/whatsapp are logged stubs in v1)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}
