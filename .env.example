# ── Database ─────────────────────────────────────────────────────────────────
# SQLite is fine for local dev and small teams. For production use PostgreSQL:
#   DATABASE_URL="postgresql://user:pass@host:5432/mydb"
DATABASE_URL="file:./dev.db"

# ── Security ─────────────────────────────────────────────────────────────────
# Signs session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET="change-me-in-production"

# Password gate on the Money section, on top of the normal role check.
FINANCE_PASSWORD="change-me"

# Optional shared secret for the escalation cron endpoint (/api/cron/escalations)
CRON_SECRET=""

# ── First-run admin account (used by `npm run db:setup`) ─────────────────────
ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="changeme123"

# ── Branding (optional — defaults live in src/lib/brand.ts) ──────────────────
# NEXT_PUBLIC_APP_NAME="Nucleus"
# NEXT_PUBLIC_APP_PRODUCT_NAME="Nucleus OS"
# NEXT_PUBLIC_APP_SLUG="nucleus"
# NEXT_PUBLIC_APP_EMAIL_DOMAIN="example.com"

# ── Locale & currency (optional) ─────────────────────────────────────────────
# NEXT_PUBLIC_LOCALE="en-US"
# NEXT_PUBLIC_CURRENCY="USD"
